{
  "manifest_version": 3,
  "name": "AI 侧边栏助手",
  "version": "0.2.0",
  "description": "在浏览器侧边栏一键打开 ChatGPT/Claude/Gemini 等真实网页端；任意网页（含禁止复制站点）选中文字即可自动复制、引用并一键插入 AI 输入框。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "AI 侧边栏助手（点击打开）",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "scripting",
    "tabs",
    "clipboardWrite",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/lib-init.js",
        "lib/storage.js",
        "lib/clipboard.js",
        "lib/format.js",
        "lib/extract.js",
        "src/content/lib.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/content.css", "assets/icons/*", "assets/site-icons/*", "src/onboarding/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove_frame_headers",
        "enabled": true,
        "path": "rules/remove_frame_headers.json"
      }
    ]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "打开/聚焦 AI 侧边栏"
    },
    "copy-current-tab": {
      "suggested_key": { "default": "Alt+1" },
      "description": "复制当前标签页信息"
    },
    "toggle-autocopy": {
      "suggested_key": { "default": "Alt+3" },
      "description": "切换选中文字自动复制"
    },
    "open-history": {
      "suggested_key": { "default": "Alt+4" },
      "description": "打开剪贴板历史记录"
    }
  }
}
